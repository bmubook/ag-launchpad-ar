# ============================================================
# ملف قالب المتغيرات البيئية (.env.example)
# ============================================================
# انسخ هذا الملف وسمّه (.env) ثم املأ القيم الحقيقية.
# لا ترفع ملف (.env) الحقيقي إلى Git أبداً!
# ============================================================

# --- إعدادات التطبيق العامة ---
APP_NAME=my-project
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# --- Firebase: إعدادات العميل (من لوحة Firebase ← إعدادات المشروع ← تطبيقاتك) ---
# معرّفات عامة بطبيعتها — الحماية الحقيقية في قواعد الأمان (firestore.rules) — لكنها تبقى خارج الكود.
# أضف البادئة المناسبة لإطار عملك: NEXT_PUBLIC_ في Next.js، أو EXPO_PUBLIC_ في Expo
# (مثال: NEXT_PUBLIC_FIREBASE_API_KEY). مشاريع Flutter لا تحتاجها: يولّدها الأمر flutterfire configure.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Firebase Admin: كود الخادم فقط (سرّي) ---
# مسار ملف حساب الخدمة (Service Account) — احفظ الملف خارج مجلد المشروع ولا ترفعه أبداً.
# داخل Cloud Functions و App Hosting لا تحتاجه (الصلاحيات تُمنح تلقائياً).
GOOGLE_APPLICATION_CREDENTIALS=

# --- خدمات خارجية (Third-Party Services) — للخادم فقط ---
# في الإنتاج تُحفظ في Secret Manager لا في الملفات
# STRIPE_SECRET_KEY=
# RESEND_API_KEY=
