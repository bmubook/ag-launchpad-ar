{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      { "command": "node .claude/hooks/prompt-submit.mjs --host=cursor", "timeout": 10 }
    ],
    "preToolUse": [
      { "command": "node .claude/hooks/guard-secrets.mjs --host=cursor", "matcher": "Read|Write|Delete|Shell|Grep", "timeout": 10 }
    ],
    "postToolUse": [
      { "command": "node .claude/hooks/post-edit.mjs --host=cursor", "matcher": "Write", "timeout": 10 }
    ],
    "stop": [
      { "command": "node .claude/hooks/stop-gate.mjs --host=cursor", "timeout": 15, "loop_limit": 1 }
    ]
  }
}
